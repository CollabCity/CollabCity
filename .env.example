# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL 17 + PostGIS 3.5)
# Local: `pnpm db:up` sobe o container definido em docker-compose.yml.
# Produção: string de conexão do Neon, Supabase ou outro Postgres com PostGIS.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://collabcity:collabcity@localhost:5432/collabcity"

# ---------------------------------------------------------------------------
# Autenticação (Better Auth)
# Gere o segredo com: openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="troque-por-um-segredo-de-32-bytes"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth opcional. Deixe em branco para usar apenas e-mail e senha.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Armazenamento de imagens
# "local" grava em .uploads/ (desenvolvimento).
# "s3" usa qualquer serviço compatível com S3, como Cloudflare R2.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
