# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL 17 + PostGIS 3.5)
# Local: `pnpm db:up` sobe o container definido em docker-compose.yml.
# Produção: string de conexão do Neon, Supabase ou outro Postgres com PostGIS.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://collabcity:collabcity@localhost:5432/collabcity"

# Banco dos testes de ponta a ponta. A suíte apaga e repopula o banco que
# receber, então ele nunca pode ser o de desenvolvimento. Deixe em branco para
# usar o padrão: o mesmo servidor, no banco `collabcity_e2e`, criado sozinho.
E2E_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Autenticação (Better Auth)
# Gere o segredo com: openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="troque-por-um-segredo-de-32-bytes"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth opcional. Deixe em branco para usar apenas e-mail e senha.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Armazenamento de imagens
# "local" grava em public/uploads/ e serve para desenvolvimento apenas: em
#   hospedagem serverless o disco é efêmero e somente leitura, e cada instância
#   teria os seus próprios arquivos.
# "s3" usa qualquer serviço compatível com a API do S3. Aqui "S3" é o
#   protocolo, e NÃO a Amazon: a AWS S3 não tem camada gratuita permanente e
#   cobra egresso, que é justamente o custo que pesa em servir imagens.
#   O alvo é o Cloudflare R2 — 10 GB, 1 milhão de escritas e 10 milhões de
#   leituras por mês, com egresso zero. Backblaze B2 também serve.
#   Com "s3", as cinco variáveis abaixo são obrigatórias: a aplicação recusa o
#   envio de imagens se faltar alguma, em vez de falhar na primeira foto.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Manutenção
# Segredo da rota que expurga contas com prazo de exclusão vencido.
#   Sem ele a rota não existe — responde 404.
#   Na Vercel, basta definir CRON_SECRET: a plataforma o injeta no cabeçalho
#   das chamadas agendadas, e a rota aceita os dois nomes.
#   Em QUALQUER ambiente com contas de verdade, configure um dos dois e o
#   agendador correspondente — sem isso nenhuma exclusão chega a ser
#   executada, e a pessoa acredita que foi excluída. Ver docs/deployment.md.
# ---------------------------------------------------------------------------
MAINTENANCE_SECRET=""
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Medição e publicidade
# Opcionais: sem elas, nenhum script de terceiro carrega e o banner de
#   consentimento nem aparece — é o padrão em desenvolvimento.
# Nada carrega antes do aceite de quem visita. Ver ADR-0022.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT=""

# ---------------------------------------------------------------------------
# Política de privacidade
# Quem opera esta instância é o controlador dos dados, na definição da LGPD —
#   não o repositório. Preencha em qualquer ambiente com pessoas de verdade:
#   sem isso, a política declara publicamente que o operador não se
#   identificou, o que basta para desenvolvimento e não para produção.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PRIVACY_CONTROLLER=""
NEXT_PUBLIC_PRIVACY_CONTACT=""
